        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "(sum(crossplane_managed_resource_exists{namespace=\"$namespace\"}) - sum(crossplane_managed_resource_ready{namespace=\"$namespace\"})) or vector(0)",
