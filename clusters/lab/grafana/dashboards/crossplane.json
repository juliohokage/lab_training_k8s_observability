      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (gvk) (increase(crossplane_managed_resource_first_time_to_readiness_seconds_count{namespace=\"$namespace\"}[$__rate_interval])) > 0",
          "legendFormat": "{{gvk}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
