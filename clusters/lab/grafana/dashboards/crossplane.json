          "expr": "sum(increase(function_run_function_response_total{namespace=\"$namespace\", grpc_code!=\"OK\"}[$__range]) or increase(function_run_function_response_total{namespace=\"$namespace\", result_severity=\"Fatal\"}[$__range])) or vector(0)",
