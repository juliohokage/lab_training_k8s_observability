    {
      "type": "timeseries",
      "title": "Time to first Ready \u2014 p50 / p95 by kind",
      "description": "Time from creation to first Ready condition for managed resources, per kind (gvk), as observed by providers. Per-kind percentiles over the dashboard range. For one specific tenant XR, compare its Ready condition lastTransitionTime with its creationTimestamp (kubectl get <xr> -o yaml).",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.50, sum by (gvk, le) (increase(crossplane_managed_resource_first_time_to_readiness_seconds_bucket{namespace=\"$namespace\"}[$__range])))",
          "legendFormat": "p50 {{gvk}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum by (gvk, le) (increase(crossplane_managed_resource_first_time_to_readiness_seconds_bucket{namespace=\"$namespace\"}[$__range])))",
          "legendFormat": "p95 {{gvk}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "noValue": "No managed resource became Ready in this range"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Resources that became Ready, by kind",
      "description": "New managed resources reaching Ready for the first time \u2014 each bump is an onboarding event.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
