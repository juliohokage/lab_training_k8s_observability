    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "🧪 Test signals — telemetrygen → OTel gateway → Victoria* backends",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Test metric status",
      "description": "Gauge 'running' sent by telemetrygen. Green = a sample arrived in the last 2 minutes.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "last_over_time({__name__=\"running\", \"service.name\"=\"telemetrygen\"}[2m])",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed"
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": -1e+18,
                "to": 1e+18,
                "result": {
                  "text": "✅ Running",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "noValue": "❌ Not running"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Log lines 'hello this is working' (range)",
      "description": "Count of telemetrygen log lines in VictoriaLogs over the dashboard time range.",
